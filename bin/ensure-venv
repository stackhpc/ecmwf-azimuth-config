#!/usr/bin/env bash

#####
# This script creates a virtualenv and installs the required dependencies
#####


# Check python version
# NOTE: Python 3.10 or newer is required by the current dependency set.
PY_MAJOR=3
PY_MINOR=10
version_check() {
cat << EOF | "$1" -
import sys
if sys.version_info[0] < $PY_MAJOR or sys.version_info[1] < $PY_MINOR:
  sys.exit(1)
EOF
}

python_version() {
cat << 'EOF' | "$1" -
import sys
print(f"{sys.version_info[0]}.{sys.version_info[1]}")
EOF
}

pip_check() {
  "$1" -m pip --version >/dev/null 2>&1
}

bootstrap_pip() {
  local python="$1"
  local python_version_string

  echo "Bootstrapping pip in virtual environment"
  if "$python" -m ensurepip --upgrade; then
    return 0
  fi

  python_version_string="$(python_version "$python")"
  echo "Failed to install pip into the virtual environment." 1>&2
  echo "On Ubuntu/Debian, install the venv package for this interpreter, e.g. sudo apt install python${python_version_string}-venv (or python3-venv for the default system Python)." 1>&2
  return 1
}

find_python() {
  local candidate

  if [ -n "$AZIMUTH_PYTHON" ]; then
    if ! command -v "$AZIMUTH_PYTHON" >/dev/null 2>&1; then
      echo "Requested Python interpreter '$AZIMUTH_PYTHON' was not found" 1>&2
      return 1
    fi
    if ! version_check "$AZIMUTH_PYTHON"; then
      echo "Requested Python interpreter '$AZIMUTH_PYTHON' does not meet the minimum required version of $PY_MAJOR.$PY_MINOR" 1>&2
      return 1
    fi
    printf "%s\n" "$AZIMUTH_PYTHON"
    return 0
  fi

  for candidate in python3 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$candidate" >/dev/null 2>&1 && version_check "$candidate"; then
      printf "%s\n" "$candidate"
      return 0
    fi
  done

  return 1
}

AZIMUTH_PYTHON="$(find_python)"
if [ -z "$AZIMUTH_PYTHON" ]; then
  echo "Minimum required python version is $PY_MAJOR.$PY_MINOR" 1>&2
  echo "Please install a supported version or set AZIMUTH_PYTHON to one, e.g. AZIMUTH_PYTHON=python3.10" 1>&2
  exit 1
fi

echo "Using Python interpreter: $AZIMUTH_PYTHON"

AZIMUTH_CONFIG_ROOT="$(dirname $(dirname $(realpath ${BASH_SOURCE[0]:-${(%):-%x}})))"

AZIMUTH_VENV="$AZIMUTH_CONFIG_ROOT/.venv"
AZIMUTH_VENV_PYTHON="$AZIMUTH_VENV/bin/python"
if [ -d "$AZIMUTH_VENV" ] && { [ ! -x "$AZIMUTH_VENV_PYTHON" ] || ! version_check "$AZIMUTH_VENV_PYTHON"; }; then
  echo "Recreating virtual environment at $AZIMUTH_VENV because it uses an unsupported Python version"
  rm -rf "$AZIMUTH_VENV"
fi

if [ ! -d "$AZIMUTH_VENV" ]; then
  echo "Creating virtual environment at $AZIMUTH_VENV"
  "$AZIMUTH_PYTHON" -m venv "$AZIMUTH_VENV"
fi

if ! pip_check "$AZIMUTH_VENV_PYTHON"; then
  bootstrap_pip "$AZIMUTH_VENV_PYTHON"
fi

echo "Upgrading pip"
"$AZIMUTH_VENV/bin/python" -m pip install -U pip

echo "Installing requirements"
"$AZIMUTH_VENV/bin/python" -m pip install -r "$AZIMUTH_CONFIG_ROOT/requirements.txt"
